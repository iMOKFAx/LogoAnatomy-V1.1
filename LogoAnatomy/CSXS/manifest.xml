<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.mohamedmostafa.logoanatomy" ExtensionBundleVersion="1.1.0" ExtensionBundleName="Logo Anatomy" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.mohamedmostafa.logoanatomy.panel" Version="1.1.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[26.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.mohamedmostafa.logoanatomy.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Logo Anatomy</Menu>
          <Geometry>
            <Size><Height>600</Height><Width>340</Width></Size>
            <MinSize><Height>400</Height><Width>280</Width></MinSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/icon_normal.png</Icon>
            <Icon Type="DarkNormal">./icons/icon_dark.png</Icon>
            <Icon Type="RollOver">./icons/icon_normal.png</Icon>
            <Icon Type="DarkRollOver">./icons/icon_dark.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
